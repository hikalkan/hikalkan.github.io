---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ActionLink from '../components/ActionLink.astro';
import { getBooks } from '../lib/content';
import { imageByName } from '../lib/images';

const books = await getBooks();
const linkIcon = { buy: 'cart', download: 'download', website: 'globe', source: 'github' } as const;
---

<BaseLayout title="Books" description="Books by Halil İbrahim Kalkan: Mastering ABP Framework (Packt) and the free e-book Implementing Domain Driven Design.">
  <PageHeader title="Books">
    <p>Books I've written on building maintainable .NET solutions.</p>
  </PageHeader>

  <div class="space-y-8">
    {
      books.map(({ data: b }, i) => (
        <article class="grid items-center gap-8 rounded-3xl border border-line bg-card p-6 sm:grid-cols-[16rem_1fr] sm:p-10">
          <Image
            src={imageByName(b.image)}
            alt={`${b.title} cover`}
            widths={[300, 600]}
            sizes="(min-width: 640px) 256px, 80vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            class="mx-auto w-full max-w-64"
          />
          <div>
            <p class="text-xs font-medium tracking-wide text-accent uppercase">{b.published}</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight text-balance">{b.title}</h2>
            {b.subtitle && <p class="mt-2 text-muted italic">{b.subtitle}</p>}
            <p class="mt-4 leading-relaxed text-muted">{b.description}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              {b.links.map((l, j) => (
                <ActionLink href={l.url} icon={linkIcon[l.kind]} variant={j === 0 ? 'primary' : 'secondary'}>
                  {l.label}
                </ActionLink>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>
