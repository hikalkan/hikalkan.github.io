---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ActionLink.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import TalkItem from '../components/TalkItem.astro';
import { firstPhotoByTalk, getArticles, getBooks, getGallery, getProjects } from '../lib/content';
import { imageByName } from '../lib/images';
import { site, social } from '../lib/site';
import { getTalks, talkStats, youTubeId, formatTalkDate } from '../lib/talks';
import portrait from '../assets/images/portrait.jpg';

const talks = await getTalks();
const gallery = await getGallery();
const photoByTalk = firstPhotoByTalk(gallery);
const mosaic = gallery
  .filter((photo) => photo.data.featured)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const stats = talkStats(talks);
const articles = await getArticles();
const books = await getBooks();
const projects = (await getProjects()).filter((p) => p.data.status === 'active');

const recentTalks = talks
  .filter((t) => t.data.format !== 'meetup')
  .filter((t, i, all) => all.findIndex((other) => other.data.title === t.data.title) === i)
  .slice(0, 4);
const featuredVideoIds = [
  '2024-dotnet-conf-modular-monolith',
  '2024-devdays-vilnius-kubernetes',
  '2022-dotnet-conf-authorization',
];
const featuredVideos = featuredVideoIds
  .map((id) => talks.find((t) => t.id === id)!)
  .map((t) => ({ talk: t, youTube: youTubeId(t.data.video!)! }));

const numbers = [
  { value: stats.total, label: 'talks' },
  { value: stats.countries, label: 'countries' },
  { value: articles.length, label: 'articles' },
  { value: books.length, label: 'books' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: `https://${site.domain}`,
  jobTitle: 'Software Architect',
  worksFor: { '@type': 'Organization', name: 'Volosoft', url: 'https://volosoft.com' },
  sameAs: social.map((s) => s.url),
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="flex flex-col-reverse gap-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <p class="mb-4 text-sm font-medium text-accent">Software architect · Co-founder of Volosoft</p>
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Halil İbrahim Kalkan</h1>
      <p class="mt-6 text-lg leading-relaxed text-pretty text-muted">
        I'm the lead architect of the open source
        <a href="https://abp.io" class="link">ABP Framework</a> and the author of
        <a href="/books" class="link">Mastering ABP Framework</a>. I love working on open source, writing articles and
        speaking at conferences about Domain-Driven Design, modular architectures and .NET.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <ActionLink href="/talks" variant="primary">See my talks</ActionLink>
        <ActionLink href="/speaker-kit">Speaker kit</ActionLink>
        <SocialLinks class="ml-1" />
      </div>
    </div>
    <Image
      src={portrait}
      alt="Halil İbrahim Kalkan speaking at a conference"
      widths={[160, 320, 460]}
      sizes="(min-width: 640px) 208px, 128px"
      loading="eager"
      class="size-32 shrink-0 rounded-full object-cover object-[center_40%] ring-1 ring-line sm:size-52"
    />
  </section>

  <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4">
    {
      numbers.map((n) => (
        <div class="bg-bg px-6 py-5">
          <dt class="sr-only">{n.label}</dt>
          <dd>
            <span class="block text-3xl font-semibold tracking-tight tabular-nums">{n.value}</span>
            <span class="text-sm text-muted">{n.label}</span>
          </dd>
        </div>
      ))
    }
  </dl>

  <section class="mt-16">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 class="text-xl font-semibold tracking-tight">On stage</h2>
      <a href="/photos" class="inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-fg">
        All photos <Icon name="arrow-right" class="size-3.5" />
      </a>
    </div>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      {
        mosaic.map((photo, i) => (
          <a
            href={`/photos#${photo.id}`}
            class:list={[
              'group relative block h-full overflow-hidden rounded-xl',
              i === 0 ? 'col-span-2 aspect-[16/10] sm:row-span-2 sm:aspect-auto' : 'aspect-[4/3]',
            ]}
          >
            <Image
              src={imageByName(photo.data.image)}
              alt={photo.data.alt}
              widths={i === 0 ? [640, 960] : [320, 480]}
              sizes={i === 0 ? '(min-width: 896px) 430px, 100vw' : '(min-width: 896px) 210px, 50vw'}
              class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
              style={{ objectPosition: photo.data.focus }}
            />
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-24">
    <div class="mb-6 flex items-baseline justify-between gap-4">
      <h2 class="text-xl font-semibold tracking-tight">What I'm working on</h2>
      <a href="/projects" class="inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-fg">
        All projects <Icon name="arrow-right" class="size-3.5" />
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        projects.map(({ data: p }) => (
          <a
            href={p.links[0]?.url}
            target="_blank"
            rel="noopener"
            class="group flex items-start gap-4 rounded-2xl border border-line p-4 transition-colors hover:border-faint sm:flex-col"
          >
            <Image src={imageByName(p.image!)} alt="" width={96} height={60} class="h-12 w-[77px] shrink-0 rounded-lg border border-line object-cover" />
            <div>
              <h3 class="flex items-center gap-1 font-medium">
                {p.name}
                <Icon name="arrow-up-right" class="size-3.5 text-faint transition-colors group-hover:text-fg" />
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{p.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-24">
    <div class="mb-2 flex items-baseline justify-between gap-4">
      <h2 class="text-xl font-semibold tracking-tight">Recent talks</h2>
      <a href="/talks" class="inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-fg">
        All {stats.total} talks <Icon name="arrow-right" class="size-3.5" />
      </a>
    </div>
    <ul class="divide-y divide-line">
      {recentTalks.map((talk) => (
        <TalkItem talk={talk} photosHref={photoByTalk.has(talk.id) ? `/photos#${photoByTalk.get(talk.id)}` : undefined} />
      ))}
    </ul>
  </section>

  <section class="mt-24">
    <h2 class="mb-6 text-xl font-semibold tracking-tight">Watch</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      {
        featuredVideos.map(({ talk, youTube }) => (
          <a href={talk.data.video} target="_blank" rel="noopener" class="group">
            <div class="relative overflow-hidden rounded-xl border border-line bg-card">
              <img
                src={`https://i.ytimg.com/vi/${youTube}/hqdefault.jpg`}
                alt=""
                width="480"
                height="360"
                loading="lazy"
                class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
              <span class="absolute inset-0 grid place-items-center bg-black/10 transition-colors group-hover:bg-black/25">
                <span class="grid size-11 place-items-center rounded-full bg-white/90 text-zinc-900 shadow-lg">
                  <Icon name="youtube" class="size-5" />
                </span>
              </span>
            </div>
            <h3 class="mt-3 text-sm font-medium text-pretty transition-colors group-hover:text-accent">{talk.data.title}</h3>
            <p class="mt-1 text-sm text-muted">
              {talk.data.event} · {formatTalkDate(talk.data.date)}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-24 grid gap-4 sm:grid-cols-2">
    {
      books.map(({ data: b }) => (
        <a
          href="/books"
          class="group flex items-center gap-5 rounded-2xl border border-line bg-card p-5 transition-colors hover:border-faint"
        >
          <Image src={imageByName(b.image)} alt="" width={120} class="w-20 shrink-0" />
          <div>
            <p class="text-xs font-medium tracking-wide text-accent uppercase">{b.published}</p>
            <h3 class="mt-1 font-semibold tracking-tight">{b.title}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-muted">{b.subtitle}</p>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>
