---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ActionLink.astro';
---

<BaseLayout title="Page not found">
  <div class="py-20 text-center">
    <p class="text-sm font-medium text-accent tabular-nums">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8 flex justify-center gap-3">
      <ActionLink href="/" variant="primary">Go home</ActionLink>
      <ActionLink href="/talks">Browse talks</ActionLink>
    </div>
  </div>
</BaseLayout>
