---
import Icon from './Icon.astro';
import { nav, site } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-4xl items-center justify-between gap-6 px-6">
    <a href="/" class="font-semibold tracking-tight text-fg">{site.name}</a>

    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-2.5 py-1.5 text-sm transition-colors',
              isActive(item.href) ? 'text-fg' : 'text-muted hover:text-fg',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-fg"
        aria-label="Toggle dark mode"
      >
        <Icon name="moon" class="size-[18px] dark:hidden" />
        <Icon name="sun" class="hidden size-[18px] dark:block" />
      </button>
      <button
        type="button"
        data-menu-toggle
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-fg lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="hidden border-t border-line/60 lg:hidden">
    <ul class="mx-auto max-w-4xl px-4 py-3">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'block rounded-md px-2 py-2.5 text-[15px]',
                isActive(item.href) ? 'text-fg' : 'text-muted hover:text-fg',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });

  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  menuButton?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
