---
import Icon from './Icon.astro';
import { formats, topics } from '../lib/taxonomy';
import { formatTalkDate, type Talk } from '../lib/talks';

interface Props {
  talk: Talk;
  /** Renders topics as filter buttons (used on the talks page). */
  filterable?: boolean;
}

const { talk, filterable = false } = Astro.props;
const t = talk.data;
const badges = [t.format !== 'conference' && formats[t.format], t.role === 'co-speaker' && 'Co-speaker'].filter(Boolean);
---

<li
  class="group py-5"
  data-talk
  data-topics={t.topics.join(' ')}
  data-format={t.format}
  data-scope={t.scope}
  data-video={t.video ? '1' : '0'}
>
  <h3 class="font-medium text-pretty text-fg">
    {
      t.sessionUrl ? (
        <a href={t.sessionUrl} target="_blank" rel="noopener" class="transition-colors hover:text-accent">
          {t.title}
        </a>
      ) : (
        t.title
      )
    }
  </h3>

  <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
    {
      t.eventUrl ? (
        <a href={t.eventUrl} target="_blank" rel="noopener" class="transition-colors hover:text-fg">
          {t.event}
        </a>
      ) : (
        <span>{t.event}</span>
      )
    }
    <span class="text-faint" aria-hidden="true">·</span>
    <span>{t.location}</span>
    <span class="text-faint" aria-hidden="true">·</span>
    <time datetime={t.date}>{formatTalkDate(t.date)}</time>
    {
      badges.map((b) => (
        <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">{b}</span>
      ))
    }
  </p>

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
    {
      t.video && (
        <a href={t.video} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-medium text-fg transition-colors hover:text-accent">
          <Icon name="play" class="size-4" /> Watch
        </a>
      )
    }
    {
      t.slides && (
        <a href={t.slides} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-medium text-fg transition-colors hover:text-accent">
          <Icon name="slides" class="size-4" /> Slides
        </a>
      )
    }
    <span class="flex flex-wrap gap-1.5">
      {
        t.topics.map((topic) =>
          filterable ? (
            <button
              type="button"
              data-topic-link={topic}
              class="rounded px-1.5 py-0.5 text-xs text-faint transition-colors hover:bg-card hover:text-fg"
            >
              #{topics[topic]}
            </button>
          ) : (
            <span class="px-1.5 py-0.5 text-xs text-faint">#{topics[topic]}</span>
          ),
        )
      }
    </span>
  </div>
</li>
